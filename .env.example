# Modèle de configuration. Copiez-le en « .env » (jamais versionné) et remplissez-le :
#   cp .env.example .env
# Docker Compose lit ce fichier tout seul ; en local, app.py le charge au démarrage.

# --- Espace d'administration des tickets ---------------------------------------------
# Identifiant PASS qui voit « Tickets reçus ». Vide = pas d'espace d'administration.
ADMIN_USERNAME=
# Adresse prévenue à l'ouverture d'un ticket.
ADMIN_EMAIL=contact@baumgaertner.fr

# --- Envoi des e-mails ---------------------------------------------------------------
# Exemple iCloud+ (domaine personnalisé) : le mot de passe doit être un « mot de passe
# pour application » créé sur appleid.apple.com, et SMTP_FROM une adresse déclarée dans
# iCloud Mail. Laissez SMTP_SSL vide pour le port 587 (STARTTLS) ; mettez 1 pour le 465.
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587
SMTP_SSL=
SMTP_USER=votre-identifiant@icloud.com
SMTP_PASSWORD=
SMTP_FROM=contact@baumgaertner.fr

# --- Déploiement ----------------------------------------------------------------------
# Sous-chemin derrière un reverse proxy (ex. /emargement) ; vide = servi à la racine.
BASE_URL_PATH=
# Port publié par docker compose.
HOST_PORT=8080
